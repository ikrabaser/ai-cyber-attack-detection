# Kopyala: cp .env.example .env  ve değerleri değiştir. .env'i git'e ekleme.

# --- Veritabanı ---
POSTGRES_DB=ids
POSTGRES_USER=ids
POSTGRES_PASSWORD=degistir-beni

# --- Django ---
DJANGO_SECRET_KEY=degistir-beni-uzun-rastgele-bir-deger
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Gerçek zamanlı katman (Centrifugo) ---
# Backend -> Centrifugo yayın anahtarı (HTTP API)
RT_API_URL=http://centrifugo:8000/api
RT_API_KEY=degistir-beni-api-anahtari
# Centrifugo -> backend proxy isteklerinde doğrulanan ortak sır
RT_PROXY_SECRET=degistir-beni-proxy-sirri

# --- Sensör -> backend olay girişi (POST /api/events/) ---
SENSOR_API_TOKEN=degistir-beni-sensor-tokeni

# --- Korumalı IP/ağlar: asla engellenmez, izole edilmez ---
# Ağ geçidi, DNS, sensör VM, yönetici makinesi. CIDR de yazılabilir.
# Saldırı testi yaptığın saldırgan VM'in IP'sini BURAYA YAZMA.
PROTECTED_IPS=192.168.56.1,192.168.56.2,192.168.56.10,192.168.56.100
PROTECTED_HOSTS=sensor,gateway,dns

# --- Otomatik müdahale kademesi ---
# advise  : hiçbir şey otomatik yapılmaz, her eylem insan onayı bekler (başlangıç)
# dry_run : düşük riskli eylemler (TTL'li IP engeli) otomatik "yapılmış gibi" kaydedilir
# enforce : düşük riskli eylemler gerçekten uygulanır (gerçek güvenlik duvarı backend'i gerekir)
AUTO_REMEDIATION_MODE=advise
AUTO_BLOCK_TTL_SECONDS=600
MAX_AUTO_BLOCK_TTL_SECONDS=3600
APPROVAL_TTL_SECONDS=1800

# --- Risk eşikleri (0-1) ---
RISK_LOW_THRESHOLD=0.5
RISK_MEDIUM_THRESHOLD=0.7
RISK_HIGH_THRESHOLD=0.9
